# ====================================
# 로컬 개발용 환경 변수 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고, 각 항목에 맞는 값을 입력하세요.
# ====================================

# LiveKit 설정
LIVEKIT_URL=ws://echoforest-livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# AI 모델 설정 (본인의 실제 키 입력)
AI_MODEL_URL=YOUR_API_URL
AI_MODEL_API_KEY=YOUR_API_KEY_HERE

# [선택] AI 프로젝트 경로 설정 (기본값: ../echoforest-ai)
# 마스터 브랜치 구조 기준: backend와 ai 폴더가 형제(sibling) 관계임
# 만약 폴더 구조가 다르다면 이 변수를 수정하세요.
# AI_REPO_PATH=../echoforest-ai

# DB 설정 (docker-compose의 mysql 서비스명 사용)
DB_URL=jdbc:mysql://mysql:3306/echoforest?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=password
DB_ROOT_PASSWORD=password

# JWT
JWT_SECRET_KEY=secret_key_here
JWT_ACCESS_TOKEN_VALIDITY=86400000

# Gmail
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=app_password_here
