# ==============================================================================
# 1. OS & System Files (운영체제 파일 - 재귀적으로 모두 무시됨)
# ==============================================================================
# Mac OS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==============================================================================
# 2. IDE & Editor (개발 도구 설정)
# ==============================================================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
*.code-workspace

# ==============================================================================
# 3. Backend (Java / Spring Boot)
# ==============================================================================
# Build Output
/target/
/build/
/out/

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Log files
*.log

# ==============================================================================
# 4. Frontend (React + TypeScript)
# ==============================================================================
# Dependencies
node_modules/
/.pnp
.pnp.js

# Production Build Output (Vite는 dist, CRA는 build를 씀 - 둘 다 추가)
/dist/
/build/

# Testing & Coverage
/coverage/

# TypeScript specific
*.tsbuildinfo

# ESLint / Prettier Cache
.eslintcache
.prettiercache

# Environment Variables (절대 커밋 금지)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# 5. Secrets & Misc (보안 및 기타)
# ==============================================================================
*.key
*.p12
*.jks